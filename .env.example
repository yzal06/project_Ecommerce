# ==========================================
# MINTMART E-COMMERCE - MẪU BIẾN MÔI TRƯỜNG (.ENV.EXAMPLE)
# Hãy sao chép file này thành .env và điền các giá trị thực tế
# ==========================================

# Cổng khởi chạy Server Node.js
PORT=3000

# Khóa bí mật mã hóa JWT (Bảo mật phiên đăng nhập)
JWT_SECRET=your_super_secret_jwt_key_here

# ==========================================
# TÀI KHOẢN QUẢN TRỊ VIÊN (ADMIN)
# ==========================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password

# ==========================================
# CẤU HÌNH API SÀN SHOPEE (OPEN PLATFORM V2)
# ==========================================
SHOPEE_ENABLED=1
SHOPEE_PARTNER_ID=your_shopee_partner_id
SHOPEE_SHOP_ID=your_shopee_shop_id
SHOPEE_PARTNER_KEY=your_shopee_partner_key

# ==========================================
# CẤU HÌNH API SÀN LAZADA (OPEN PLATFORM)
# ==========================================
LAZADA_ENABLED=0
LAZADA_APP_KEY=your_lazada_app_key
LAZADA_APP_SECRET=your_lazada_app_secret
LAZADA_SELLER_ID=your_lazada_seller_id

# ==========================================
# CẤU HÌNH CỔNG THANH TOÁN VIETQR 24/7
# ==========================================
VIETQR_BANK_ID=MB
VIETQR_ACCOUNT_NO=your_account_number
VIETQR_ACCOUNT_NAME=CONG TY CO PHAN MINTMART VN
